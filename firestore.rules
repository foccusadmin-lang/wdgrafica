rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function logado() { return request.auth != null; }
    function emailVerificado() {
      return logado() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    // Único administrador do painel.
    function admin() {
      return emailVerificado() && request.auth.token.email == 'grupowdoficial@gmail.com';
    }
    function texto(v, max) { return v is string && v.size() <= max; }
    function novos() { return request.resource.data; }

    // ---------- ajustes do catálogo ----------
    // O catálogo e os preços ficam no site (data/catalogo.json). Aqui o ADM só oculta, renomeia ou destaca produtos.
    match /ajustes/{slug} {
      allow read: if true;
      allow delete: if admin();
      allow create, update: if admin()
        && slug.matches('^[a-z0-9-]{1,100}$')
        && novos().keys().hasOnly(['ativo', 'destaque', 'nome'])
        && novos().ativo is bool
        && novos().destaque is bool
        && texto(novos().nome, 120);
    }

    // ---------- clientes ----------
    // Cada cliente só cria/atualiza o próprio cadastro (dados vindos da conta Google).
    match /clientes/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow create, update: if logado() && request.auth.uid == uid
        && novos().keys().hasOnly(['nome', 'email', 'foto', 'ultimoLogin'])
        && novos().email == request.auth.token.email
        && texto(novos().nome, 120)
        && texto(novos().foto, 500)
        && novos().ultimoLogin == request.time;
      allow delete: if admin();
    }

    // ---------- pedidos ----------
    match /pedidos/{id} {
      // Cliente logado cria pedido em nome próprio, sempre com status "novo".
      allow create: if emailVerificado()
        && novos().keys().hasOnly(['uid', 'email', 'nome', 'obs', 'itens', 'total', 'status', 'criadoEm'])
        && novos().uid == request.auth.uid
        && novos().email == request.auth.token.email
        && novos().status == 'novo'
        && novos().criadoEm == request.time
        && texto(novos().nome, 120)
        && texto(novos().obs, 1000)
        && novos().itens is list && novos().itens.size() > 0 && novos().itens.size() <= 50
        && novos().total is number && novos().total > 0 && novos().total < 1000000;

      // Cliente vê só os próprios pedidos; ADM vê todos.
      allow read: if admin() || (logado() && resource.data.uid == request.auth.uid);

      // Só o ADM muda pedidos, e apenas o status.
      allow update: if admin()
        && novos().diff(resource.data).affectedKeys().hasOnly(['status'])
        && novos().status in ['novo', 'producao', 'pronto', 'entregue', 'cancelado'];
      allow delete: if admin();
    }

    // Qualquer outra coleção fica fechada.
  }
}
